      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0.0%' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='Margin Label' datatype='string' name='[Calculation_2817004532180725760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;[Profit Ratio] is &quot; + STR(ROUND([Calculation_1368249927221915648] * 100, 1)) + &quot;%&quot;' />
      </column>
      <column caption='High Margin' datatype='string' name='[Calculation_5205031853421133824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1368249927221915648] &gt;= [Parameters].[Parameter 1] THEN &quot;High&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Target Gap' datatype='real' name='[Calculation_7714630129385267200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) - SUM([federated.1q2w3e4r5t6y7u8i9o0p1a2s3d4f].[target])' />
