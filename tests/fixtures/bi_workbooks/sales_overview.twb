        <relation connection='bigquery.1a2b3c4d5e6f7g8h9i0j1k2l3m4n' name='Recent Returns' type='text'>WITH recent AS (
  SELECT order_id, return_reason, returned_at
  FROM `acme-analytics.sales.returns`
  WHERE returned_at &gt;= DATE_SUB(CURRENT_DATE(), INTERVAL &lt;[Parameters].[Parameter 2]&gt; DAY)
)
SELECT r.order_id, r.return_reason, o.region
FROM recent AS r
JOIN sales.orders AS o USING (order_id)</relation>
