    <datasource caption='Orders (sales)' inline='true' name='federated.0hgpf0j1fdpvv316shikk0mmdlec' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='bigquery' name='bigquery.1m3v0f50x1mtbo1d4k6pq0t5o5s4'>
            <connection CATALOG='acme-analytics' EXECCATALOG='acme-bi' authentication='yes' bq-fetch-tasks='10' bq_schema='sales' class='bigquery' connection-dialect='google-sql' project='acme-analytics' schema='sales' server-oauth='' username='' />
          </named-connection>
        </named-connections>
        <relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[customer_id]' />
              <expression op='[Customer Segments].[customer_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.1m3v0f50x1mtbo1d4k6pq0t5o5s4' name='orders' table='[acme-analytics.sales].[orders]' type='table' />
          <relation connection='bigquery.1m3v0f50x1mtbo1d4k6pq0t5o5s4' name='Customer Segments' type='text'>SELECT c.customer_id,
       s.segment_name
FROM `acme-analytics.crm.customers` AS c
JOIN `acme-analytics.crm.segments` AS s
  ON s.segment_id = c.segment_id
WHERE c.is_test = FALSE</relation>
        </relation>
        <cols>
